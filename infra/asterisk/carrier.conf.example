[carrier-auth]
type=auth
auth_type=userpass
username=REPLACE_ACCOUNT
password=REPLACE_SECRET

[carrier-aor]
type=aor
contact=sip:REPLACE_PROVIDER_HOST:5060

[carrier]
type=endpoint
transport=transport-udp
context=from-carrier
disallow=all
allow=ulaw,alaw
outbound_auth=carrier-auth
aors=carrier-aor
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[carrier-identify]
type=identify
endpoint=carrier
match=REPLACE_PROVIDER_IP

[carrier-registration]
type=registration
transport=transport-udp
outbound_auth=carrier-auth
server_uri=sip:REPLACE_PROVIDER_HOST
client_uri=sip:REPLACE_ACCOUNT@REPLACE_PROVIDER_HOST
retry_interval=60
