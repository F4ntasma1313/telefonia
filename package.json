{
  "name": "nexuscc-call-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "docs:api": "tsx scripts/openapi.ts",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "format": "prettier --write src scripts worker tests docs *.md *.ts *.mjs *.json",
    "telephony": "tsx --env-file=.env.local worker/index.ts",
    "bootstrap": "tsx --env-file=.env.local scripts/bootstrap.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sip.js": "^0.21.2",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
